# ============================================================
# 1. Qt 编译产物 - 所有平台相关二进制文件
# ============================================================

# 对象文件
*.o
*.obj

# 可执行文件
*.exe
*.exe~

# 动态链接库
*.dll
*.dll~

# 静态库
*.lib
*.lib~

# 导入库
*.exp

# 增量链接文件
*.ilk

# 程序数据库文件（调试符号）
*.pdb

# 编译数据库
*.idb

# 预编译头文件
*.pch

# ============================================================
# 2. Qt 构建目录和生成的文件
# ============================================================

# Debug/Release 构建目录
debug/
release/
Debug/
Release/

# qmake 生成的 Makefile
Makefile
Makefile.Debug
Makefile.Release

# qmake 缓存文件
.qmake.stash

# Qt Moc/Uic/Rcc 生成的文件
moc_*.cpp
ui_*.h
qrc_*.cpp

# ============================================================
# 3. Qt Creator IDE 配置文件
# ============================================================

# Qt Creator 用户配置（包含本地路径，不应共享）
*.pro.user
*.pro.user.*
*.creator
*.creator.user
*.creator.user.*
*.files
*.files.user
*.includes
*.includes.user

# Qt Creator 会话文件
*.qws

# ============================================================
# 4. Visual Studio 相关文件（MSVC 编译器）
# ============================================================

# Visual Studio 用户配置
*.suo
*.user
*.sln.docstates

# Visual Studio 临时文件和日志
*.tlog
*.lastbuildstate
*.Build.Cpp.Clean
*.log

# IntelliSense 数据库
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# ReSharper C++
*_ReSharper*/
*.resharper
*.DotSettings

# ============================================================
# 5. 运行时生成的数据文件
# ============================================================

# 测试数据存储目录
bin/Data/

# 导出文件目录
bin/Export/

# 运行日志目录
bin/log/

# 数据库文件（如果有）
*.sqlite
*.sqlite3
*.db

# ============================================================
# 6. 第三方运行时库（应通过安装程序获取）
# ============================================================

# Qt 运行时库（Debug 版本）
bin/Qt5Cored.dll
bin/Qt5Guid.dll
bin/Qt5Networkd.dll
bin/Qt5PrintSupportd.dll
bin/Qt5SerialPortd.dll
bin/Qt5Sqld.dll
bin/Qt5Svgd.dll
bin/Qt5Widgetsd.dll

# Qt 运行时库（Release 版本）
bin/Qt5Core.dll
bin/Qt5Gui.dll
bin/Qt5Network.dll
bin/Qt5PrintSupport.dll
bin/Qt5SerialPort.dll
bin/Qt5Sql.dll
bin/Qt5Svg.dll
bin/Qt5Widgets.dll

# OpenGL 和图形库
bin/libEGLd.dll
bin/libEGL.dll
bin/libGLESV2d.dll
bin/libGLESV2.dll
bin/D3Dcompiler_*.dll
bin/opengl32sw.dll

# MSVC 运行时库
bin/msvcp*.dll
bin/vcruntime*.dll
bin/ucrtbased.dll
bin/ucrtbase.dll
bin/VC_x86Runtime.exe

# Qt 插件目录
bin/platforms/
bin/imageformats/
bin/iconengines/
bin/bearer/
bin/printsupport/
bin/sqldrivers/
bin/styles/
bin/translations/

# ============================================================
# 7. 模板和缓存文件
# ============================================================

# OS X
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# 8. 压缩包和备份文件
# ============================================================

*.zip
*.rar
*.7z
*.tar.gz
*.bak
*.backup
*~

# ============================================================
# 9. 日志和临时文件（根目录）
# ============================================================

*.log
*.tmp
*.temp

# ============================================================
# 10. Python（如果有辅助脚本）
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyc

# ============================================================
# 11. Qt 构建产物 - Debug/Release 目录
# ============================================================

# 忽略所有路径下的 debug 和 release 目录（递归）
**/debug/
**/release/

# ============================================================
# 12. Git 配置
# ============================================================

# 保留重要文件（不被上面的规则忽略）

# 强制追踪 Core 文件和文件夹（取消 Git 默认忽略）
!Core
!Core/

# 保留配置文件模板（如果有）
# bin/PCIE.ini.template

# 保留 .gitignore 自身
!.gitignore